{
  "name": "puzzle",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev -o",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks",
    "up": "taze latest -I -f",
    "prettier": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@unocss/reset": "^66.7.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "^4.4.6",
    "sortablejs": "^1.15.7",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@ayingott/eslint-config": "^2.1.3",
    "@ayingott/prettier-config": "^2.1.11",
    "@types/sortablejs": "^1.15.9",
    "@unocss/nuxt": "^66.7.0",
    "eslint": "^10.4.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.14.1",
    "unocss": "^66.7.0",
    "vue": "^3.5.35"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "prettier": "@ayingott/prettier-config"
}
