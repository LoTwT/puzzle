{
  "name": "puzzle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.13"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue}": [
      "oxlint --fix --deny-warnings",
      "oxfmt"
    ],
    "*.{css,scss,less,html,json,jsonc,yaml,yml,md,mdx}": "oxfmt"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.11.2"
}
